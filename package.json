{
  "name": "@igmarin/mcp-skills-tool",
  "mcpName": "io.github.igmarin/mcp-skills-tool",
  "version": "1.0.0",
  "description": "CLI and Cloudflare Worker MCP server to serve AI skills from directory.json packs",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-skills-tool": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igmarin/mcp-skills-tool.git"
  },
  "homepage": "https://github.com/igmarin/mcp-skills-tool#readme",
  "bugs": {
    "url": "https://github.com/igmarin/mcp-skills-tool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup-hooks": "cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "start": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js --config examples/skills-pack/directory.json",
    "inspect:dev": "npx @modelcontextprotocol/inspector tsx src/index.ts --config examples/skills-pack/directory.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.8"
  }
}
